[DEFAULT]
kwic grouper ranker = 
	<button type="button" class="control" aria-label="Close"><span aria-hidden="true">&times;</span></button>
	<legend>KWIC Grouper Ranker</legend>
	<input type="hidden" name="algprefix[algorithm_name]" value="KWIC Grouper Ranker">
	<label for="ctlb-flexiconc-algprefix[search_terms]"><span style="color: red" title="This property is required">*</span> A list of terms to search for within the tokens.</label>
	<select name="algprefix[search_terms]" id="ctlb-flexiconc-algprefix[search_terms]" class="tomselect allow-add-items" multiple="multiple"></select>
	<label for="ctlb-flexiconc-algprefix[tokens_attribute]">The token attribute to search within (e.g., &#x27;word&#x27;).</label>
	<input type="text" name="algprefix[tokens_attribute]" id="ctlb-flexiconc-algprefix[tokens_attribute]" class="form-control" value="word">
	<label for="ctlb-flexiconc-algprefix[mode]">Matching strategy for search_terms</label>
	<select name="algprefix[mode]" id="ctlb-flexiconc-algprefix[mode]" class="tomselect " ><option value="literal"  selected>literal</option> <option value="regex" >regex</option> <option value="cqp" >cqp</option></select>
	<div class="checkbox"><label>
	    <input type="checkbox" name="algprefix[case_sensitive]"  >
	    <span>If True, the search is case-sensitive.</span>
	 </label></div>
	<div class="checkbox"><label>
	    <input type="checkbox" name="algprefix[include_node]"  >
	    <span>If True, include node-level tokens in the search.</span>
	 </label></div>
	<label for="ctlb-flexiconc-algprefix[window_start]">The lower bound of the window (offset range).</label>
	<input type="number" name="algprefix[window_start]" id="ctlb-flexiconc-algprefix[window_start]" class="form-control" step="1">
	<label for="ctlb-flexiconc-algprefix[window_end]">The upper bound of the window (offset range).</label>
	<input type="number" name="algprefix[window_end]" id="ctlb-flexiconc-algprefix[window_end]" class="form-control" step="1">
	<div class="checkbox"><label>
	    <input type="checkbox" name="algprefix[count_types]"   checked>
	    <span>If True, count unique types within each line; otherwise, count all matches.</span>
	 </label></div>
	<div class="control fork" aria-role="button" aria-label="Fork"><span aria-hidden="true"><img src="/icons/fork.svg" width="13" height="18" alt="Fork from this point" /></span></div>
manual line selection = 
	<button type="button" class="control" aria-label="Close"><span aria-hidden="true">&times;</span></button>
	<legend>Manual Line Selection</legend>
	<input type="hidden" name="algprefix[algorithm_name]" value="Manual Line Selection">
	<label for="ctlb-flexiconc-algprefix[line_ids]">A list of specific line IDs to include in the subset.</label>
	<div class="button-group">
	<input type="text" name="algprefix[line_ids]" value="[]" class="lineid-picker" data-fc-select-type="line_id" readonly="readonly" >
	</div>
	<label for="ctlb-flexiconc-algprefix[groups]">A list of group identifiers (by label or number) to include lines from. For clusters, groups may be nested, and all matching groups in the hierarchy will be used.</label>
	<div class="button-group">
	<input type="text" name="algprefix[groups]" value="[]" class="lineid-picker" data-fc-select-type="partition_label" readonly="readonly" >
	</div>
	<div class="control fork" aria-role="button" aria-label="Fork"><span aria-hidden="true"><img src="/icons/fork.svg" width="13" height="18" alt="Fork from this point" /></span></div>
partition by ngrams = 
	<button type="button" class="control" aria-label="Close"><span aria-hidden="true">&times;</span></button>
	<legend>Partition by Ngrams</legend>
	<input type="hidden" name="algprefix[algorithm_name]" value="Partition by Ngrams">
	<label for="ctlb-flexiconc-algprefix[positions]"><span style="color: red" title="This property is required">*</span> The list of positions (offsets) to extract for the ngram pattern.</label>
	<select name="algprefix[positions]" id="ctlb-flexiconc-algprefix[positions]" class="tomselect allow-add-items" multiple="multiple"></select>
	<label for="ctlb-flexiconc-algprefix[tokens_attribute]">The positional attribute to search within (e.g., &#x27;word&#x27;).</label>
	<input type="text" name="algprefix[tokens_attribute]" id="ctlb-flexiconc-algprefix[tokens_attribute]" class="form-control" value="word">
	<div class="checkbox"><label>
	    <input type="checkbox" name="algprefix[case_sensitive]"  >
	    <span>If True, the search is case-sensitive.</span>
	 </label></div>
	<div class="control fork" aria-role="button" aria-label="Fork"><span aria-hidden="true"><img src="/icons/fork.svg" width="13" height="18" alt="Fork from this point" /></span></div>
random sample = 
	<button type="button" class="control" aria-label="Close"><span aria-hidden="true">&times;</span></button>
	<legend>Random Sample</legend>
	<input type="hidden" name="algprefix[algorithm_name]" value="Random Sample">
	<label for="ctlb-flexiconc-algprefix[sample_size]"><span style="color: red" title="This property is required">*</span> The number of lines to sample.</label>
	<input type="number" name="algprefix[sample_size]" id="ctlb-flexiconc-algprefix[sample_size]" class="form-control" step="1" min="1">
	<label for="ctlb-flexiconc-algprefix[seed]">The seed for random number generation.</label>
	<input type="number" name="algprefix[seed]" id="ctlb-flexiconc-algprefix[seed]" class="form-control" value="42" step="1">
	<div class="control fork" aria-role="button" aria-label="Fork"><span aria-hidden="true"><img src="/icons/fork.svg" width="13" height="18" alt="Fork from this point" /></span></div>
random sort = 
	<button type="button" class="control" aria-label="Close"><span aria-hidden="true">&times;</span></button>
	<legend>Random Sort</legend>
	<input type="hidden" name="algprefix[algorithm_name]" value="Random Sort">
	<label for="ctlb-flexiconc-algprefix[seed]">An optional seed for generating the pseudo-random order.</label>
	<input type="number" name="algprefix[seed]" id="ctlb-flexiconc-algprefix[seed]" class="form-control" value="42" step="1">
	<div class="control fork" aria-role="button" aria-label="Fork"><span aria-hidden="true"><img src="/icons/fork.svg" width="13" height="18" alt="Fork from this point" /></span></div>
select by token-level string attribute = 
	<button type="button" class="control" aria-label="Close"><span aria-hidden="true">&times;</span></button>
	<legend>Select by Token-Level String Attribute</legend>
	<input type="hidden" name="algprefix[algorithm_name]" value="Select by Token-Level String Attribute">
	<label for="ctlb-flexiconc-algprefix[search_terms]"><span style="color: red" title="This property is required">*</span> The list of string values to match against.</label>
	<select name="algprefix[search_terms]" id="ctlb-flexiconc-algprefix[search_terms]" class="tomselect allow-add-items" multiple="multiple"></select>
	<label for="ctlb-flexiconc-algprefix[tokens_attribute]">The token attribute to check (e.g., &#x27;word&#x27;).</label>
	<input type="text" name="algprefix[tokens_attribute]" id="ctlb-flexiconc-algprefix[tokens_attribute]" class="form-control" value="word">
	<label for="ctlb-flexiconc-algprefix[offset]">The token offset to check.</label>
	<input type="number" name="algprefix[offset]" id="ctlb-flexiconc-algprefix[offset]" class="form-control" step="1">
	<div class="checkbox"><label>
	    <input type="checkbox" name="algprefix[case_sensitive]"  >
	    <span>If True, performs a case-sensitive match.</span>
	 </label></div>
	<div class="checkbox"><label>
	    <input type="checkbox" name="algprefix[regex]"  >
	    <span>If True, uses regex matching.</span>
	 </label></div>
	<div class="checkbox"><label>
	    <input type="checkbox" name="algprefix[negative]"  >
	    <span>If True, inverts the selection.</span>
	 </label></div>
	<div class="control fork" aria-role="button" aria-label="Fork"><span aria-hidden="true"><img src="/icons/fork.svg" width="13" height="18" alt="Fork from this point" /></span></div>
sort by corpus position = 
	<button type="button" class="control" aria-label="Close"><span aria-hidden="true">&times;</span></button>
	<legend>Sort by Corpus Position</legend>
	<input type="hidden" name="algprefix[algorithm_name]" value="Sort by Corpus Position">
	<div class="control fork" aria-role="button" aria-label="Fork"><span aria-hidden="true"><img src="/icons/fork.svg" width="13" height="18" alt="Fork from this point" /></span></div>
sort by token-level attribute = 
	<button type="button" class="control" aria-label="Close"><span aria-hidden="true">&times;</span></button>
	<legend>Sort by Token-Level Attribute</legend>
	<input type="hidden" name="algprefix[algorithm_name]" value="Sort by Token-Level Attribute">
	<label for="ctlb-flexiconc-algprefix[tokens_attribute]">The token attribute to sort by.</label>
	<input type="text" name="algprefix[tokens_attribute]" id="ctlb-flexiconc-algprefix[tokens_attribute]" class="form-control" value="word">
	<label for="ctlb-flexiconc-algprefix[sorting_scope]">Specifies which context to use for sorting: &#x27;token&#x27; for a single token at the given offset, &#x27;left&#x27; for the entire left context (joined from right to left), or &#x27;right&#x27; for the entire right context.</label>
	<select name="algprefix[sorting_scope]" id="ctlb-flexiconc-algprefix[sorting_scope]" class="tomselect " ><option value="token"  selected>token</option> <option value="left" >left</option> <option value="right" >right</option></select>
	<label for="ctlb-flexiconc-algprefix[offset]">The offset value to filter tokens by when sorting_scope is &#x27;token&#x27;.</label>
	<input type="number" name="algprefix[offset]" id="ctlb-flexiconc-algprefix[offset]" class="form-control" step="1">
	<div class="checkbox"><label>
	    <input type="checkbox" name="algprefix[case_sensitive]"  >
	    <span>If True, performs a case-sensitive sort.</span>
	 </label></div>
	<div class="checkbox"><label>
	    <input type="checkbox" name="algprefix[reverse]"  >
	    <span>If True, sort in descending order.</span>
	 </label></div>
	<div class="checkbox"><label>
	    <input type="checkbox" name="algprefix[backwards]"  >
	    <span>If True, reverses the string (e.g., for right-to-left sorting).</span>
	 </label></div>
	<label for="ctlb-flexiconc-algprefix[locale_str]">ICU locale string for language-specific sorting.</label>
	<input type="text" name="algprefix[locale_str]" id="ctlb-flexiconc-algprefix[locale_str]" class="form-control" value="en">
	<div class="control fork" aria-role="button" aria-label="Fork"><span aria-hidden="true"><img src="/icons/fork.svg" width="13" height="18" alt="Fork from this point" /></span></div>
annotate association scores = 
	<button type="button" class="control" aria-label="Close"><span aria-hidden="true">&times;</span></button>
	<legend>Annotate Association Scores</legend>
	<input type="hidden" name="algprefix[algorithm_name]" value="Annotate Association Scores">
	<label for="ctlb-flexiconc-algprefix[corpus_frequency_list]"><span style="color: red" title="This property is required">*</span> Name of the *corpus* frequency list registered in `conc.resources`.</label>
	<input type="text" name="algprefix[corpus_frequency_list]" id="ctlb-flexiconc-algprefix[corpus_frequency_list]" class="form-control" >
	<label for="ctlb-flexiconc-algprefix[concordance_frequency_list]"><span style="color: red" title="This property is required">*</span> Name of the *concordance* frequency list registered in `conc.resources`.</label>
	<input type="text" name="algprefix[concordance_frequency_list]" id="ctlb-flexiconc-algprefix[concordance_frequency_list]" class="form-control" >
	<label for="ctlb-flexiconc-algprefix[token_attribute]">Token attribute column common to both lists.</label>
	<input type="text" name="algprefix[token_attribute]" id="ctlb-flexiconc-algprefix[token_attribute]" class="form-control" >
	<div class="checkbox"><label>
	    <input type="checkbox" name="algprefix[ignore_case]"   checked>
	    <span>Lowercase all string tokens before matching</span>
	 </label></div>
annotate with sentence transformers = 
	<button type="button" class="control" aria-label="Close"><span aria-hidden="true">&times;</span></button>
	<legend>Annotate with Sentence Transformers</legend>
	<input type="hidden" name="algprefix[algorithm_name]" value="Annotate with Sentence Transformers">
	<label for="ctlb-flexiconc-algprefix[model_name]">The name of the pretrained Sentence Transformer model.</label>
	<select name="algprefix[model_name]" id="ctlb-flexiconc-algprefix[model_name]" class="tomselect " ><option value="all-MiniLM-L6-v2"  selected>all-MiniLM-L6-v2</option></select>
	<label for="ctlb-flexiconc-algprefix[window_start]">The lower bound of the window (inclusive). If None, uses the entire line.</label>
	<input type="number" name="algprefix[window_start]" id="ctlb-flexiconc-algprefix[window_start]" class="form-control" step="1" max="0">
	<label for="ctlb-flexiconc-algprefix[window_end]">The upper bound of the window (inclusive). If None, uses the entire line.</label>
	<input type="number" name="algprefix[window_end]" id="ctlb-flexiconc-algprefix[window_end]" class="form-control" step="1" min="0">
annotate with spacy embeddings = 
	<button type="button" class="control" aria-label="Close"><span aria-hidden="true">&times;</span></button>
	<legend>Annotate with SpaCy Embeddings</legend>
	<input type="hidden" name="algprefix[algorithm_name]" value="Annotate with SpaCy Embeddings">
	<label for="ctlb-flexiconc-algprefix[spacy_model]"><span style="color: red" title="This property is required">*</span> The spaCy model to use.</label>
	<select name="algprefix[spacy_model]" id="ctlb-flexiconc-algprefix[spacy_model]" class="tomselect " ><option value="en_core_web_sm"  selected>en_core_web_sm</option> <option value="en_core_web_md" >en_core_web_md</option> <option value="en_core_web_lg" >en_core_web_lg</option></select>
	<label for="ctlb-flexiconc-algprefix[tokens_attribute]">The token attribute to use for creating line texts.</label>
	<input type="text" name="algprefix[tokens_attribute]" id="ctlb-flexiconc-algprefix[tokens_attribute]" class="form-control" value="word">
	<label for="ctlb-flexiconc-algprefix[exclude_values_attribute]">The attribute to filter out specific values.</label>
	<input type="text" name="algprefix[exclude_values_attribute]" id="ctlb-flexiconc-algprefix[exclude_values_attribute]" class="form-control" >
	<label for="ctlb-flexiconc-algprefix[exclude_values_list]">The list of values to exclude.</label>
	<select name="algprefix[exclude_values_list]" id="ctlb-flexiconc-algprefix[exclude_values_list]" class="tomselect allow-add-items" multiple="multiple"></select>
	<label for="ctlb-flexiconc-algprefix[window_start]">The lower bound of the token window (inclusive).</label>
	<input type="number" name="algprefix[window_start]" id="ctlb-flexiconc-algprefix[window_start]" class="form-control" value="-5" step="1">
	<label for="ctlb-flexiconc-algprefix[window_end]">The upper bound of the token window (inclusive).</label>
	<input type="number" name="algprefix[window_end]" id="ctlb-flexiconc-algprefix[window_end]" class="form-control" value="5" step="1">
	<div class="checkbox"><label>
	    <input type="checkbox" name="algprefix[include_node]"   checked>
	    <span>Whether to include the node token (offset 0).</span>
	 </label></div>
annotate with tf-idf = 
	<button type="button" class="control" aria-label="Close"><span aria-hidden="true">&times;</span></button>
	<legend>Annotate with TF-IDF</legend>
	<input type="hidden" name="algprefix[algorithm_name]" value="Annotate with TF-IDF">
	<label for="ctlb-flexiconc-algprefix[tokens_attribute]">The token attribute to use for creating line texts.</label>
	<input type="text" name="algprefix[tokens_attribute]" id="ctlb-flexiconc-algprefix[tokens_attribute]" class="form-control" value="word">
	<label for="ctlb-flexiconc-algprefix[exclude_values_attribute]">The attribute to filter out specific values.</label>
	<input type="text" name="algprefix[exclude_values_attribute]" id="ctlb-flexiconc-algprefix[exclude_values_attribute]" class="form-control" >
	<label for="ctlb-flexiconc-algprefix[exclude_values_list]">The list of values to exclude.</label>
	<select name="algprefix[exclude_values_list]" id="ctlb-flexiconc-algprefix[exclude_values_list]" class="tomselect allow-add-items" multiple="multiple"></select>
	<label for="ctlb-flexiconc-algprefix[window_start]">The lower bound of the token window (inclusive).</label>
	<input type="number" name="algprefix[window_start]" id="ctlb-flexiconc-algprefix[window_start]" class="form-control" value="-5" step="1">
	<label for="ctlb-flexiconc-algprefix[window_end]">The upper bound of the token window (inclusive).</label>
	<input type="number" name="algprefix[window_end]" id="ctlb-flexiconc-algprefix[window_end]" class="form-control" value="5" step="1">
	<div class="checkbox"><label>
	    <input type="checkbox" name="algprefix[include_node]"   checked>
	    <span>Whether to include the node token (offset 0).</span>
	 </label></div>
annotate with spacy pos tags = 
	<button type="button" class="control" aria-label="Close"><span aria-hidden="true">&times;</span></button>
	<legend>Annotate with spaCy POS tags</legend>
	<input type="hidden" name="algprefix[algorithm_name]" value="Annotate with spaCy POS tags">
	<label for="ctlb-flexiconc-algprefix[spacy_model]"><span style="color: red" title="This property is required">*</span> The spaCy model to use for POS tagging.</label>
	<select name="algprefix[spacy_model]" id="ctlb-flexiconc-algprefix[spacy_model]" class="tomselect " ><option value="en_core_web_sm"  selected>en_core_web_sm</option> <option value="en_core_web_md" >en_core_web_md</option> <option value="en_core_web_lg" >en_core_web_lg</option></select>
	<label for="ctlb-flexiconc-algprefix[tokens_attribute]">The token attribute to use for POS tagging.</label>
	<input type="text" name="algprefix[tokens_attribute]" id="ctlb-flexiconc-algprefix[tokens_attribute]" class="form-control" value="word">
	<label for="ctlb-flexiconc-algprefix[spacy_attributes]"><span style="color: red" title="This property is required">*</span> A list of spaCy token attributes to retrieve for annotation.</label>
	<select name="algprefix[spacy_attributes]" id="ctlb-flexiconc-algprefix[spacy_attributes]" class="tomselect " multiple="multiple"><option value="lemma_" >lemma_</option> <option value="pos_" >pos_</option> <option value="tag_" >tag_</option> <option value="morph" >morph</option> <option value="dep_" >dep_</option> <option value="ent_type_" >ent_type_</option></select>
token-level frequency list = 
	<button type="button" class="control" aria-label="Close"><span aria-hidden="true">&times;</span></button>
	<legend>Token-level Frequency List</legend>
	<input type="hidden" name="algprefix[algorithm_name]" value="Token-level Frequency List">
	<label for="ctlb-flexiconc-algprefix[token_attribute]"><span style="color: red" title="This property is required">*</span> Token attribute to count types for.</label>
	<input type="text" name="algprefix[token_attribute]" id="ctlb-flexiconc-algprefix[token_attribute]" class="form-control" value="word">
	<label for="ctlb-flexiconc-algprefix[window_start]">Lower bound of token window (inclusive). Null means unbounded.</label>
	<input type="number" name="algprefix[window_start]" id="ctlb-flexiconc-algprefix[window_start]" class="form-control" step="1">
	<label for="ctlb-flexiconc-algprefix[window_end]">Upper bound of token window (inclusive). Null means unbounded.</label>
	<input type="number" name="algprefix[window_end]" id="ctlb-flexiconc-algprefix[window_end]" class="form-control" step="1">
	<div class="checkbox"><label>
	    <input type="checkbox" name="algprefix[include_node]"  >
	    <span>Include the node token (offset 0) in the counting window.</span>
	 </label></div>

