[DEFAULT]
select slot = 
	<button type="button" class="control" aria-label="Close"><span aria-hidden="true">&times;</span></button>
	<legend>Select Slot</legend>
	<input type="hidden" name="algprefix[algorithm_name]" value="Select Slot">
	<label for="ctlb-flexiconc-algprefix[slot_id]"><span style="color: red" title="This property is required">*</span> The slot identifier to select.</label>
	<input type="number" name="algprefix[slot_id]" id="ctlb-flexiconc-algprefix[slot_id]" class="form-control" step="1">
	<button type="button" class="control fork" aria-label="Fork"><span aria-hidden="true"><img src="/icons/fork.svg" width="13" height="18" alt="Fork from this point" /></span></button>
select by sort keys = 
	<button type="button" class="control" aria-label="Close"><span aria-hidden="true">&times;</span></button>
	<legend>Select by Sort Keys</legend>
	<input type="hidden" name="algprefix[algorithm_name]" value="Select by Sort Keys">
	<pre style="border: 1px solid red">Object type is too loose: {'type': 'object', 'description': "The result from an ordering algorithm containing 'sort_keys'."}</pre>
	<label for="ctlb-flexiconc-algprefix[comparison_operator]">The comparison operator to use for sort keys.</label>
	<select name="algprefix[comparison_operator]" id="ctlb-flexiconc-algprefix[comparison_operator]" class="chosen-select " ><option value="=="  selected>==</option> <option value="&lt;=" >&lt;=</option> <option value="&gt;=" >&gt;=</option> <option value="&lt;" >&lt;</option> <option value="&gt;" >&gt;</option></select>
	<label for="ctlb-flexiconc-algprefix[value]">The value to compare the sort keys against.</label>
	<input type="number" name="algprefix[value]" id="ctlb-flexiconc-algprefix[value]" class="form-control" step="1">
	<button type="button" class="control fork" aria-label="Fork"><span aria-hidden="true"><img src="/icons/fork.svg" width="13" height="18" alt="Fork from this point" /></span></button>
select by rank = 
	<button type="button" class="control" aria-label="Close"><span aria-hidden="true">&times;</span></button>
	<legend>Select by Rank</legend>
	<input type="hidden" name="algprefix[algorithm_name]" value="Select by Rank">
	<pre style="border: 1px solid red">Object type is too loose: {'description': "The active node containing the 'ordering_result' with rank_keys."}</pre>
	<label for="ctlb-flexiconc-algprefix[comparison_operator]">The comparison operator to use for rank values.</label>
	<select name="algprefix[comparison_operator]" id="ctlb-flexiconc-algprefix[comparison_operator]" class="chosen-select " ><option value="=="  selected>==</option> <option value="&lt;=" >&lt;=</option> <option value="&gt;=" >&gt;=</option> <option value="&lt;" >&lt;</option> <option value="&gt;" >&gt;</option></select>
	<label for="ctlb-flexiconc-algprefix[value]">The value to compare the rank keys against.</label>
	<input type="number" name="algprefix[value]" id="ctlb-flexiconc-algprefix[value]" class="form-control" step="1">
	<button type="button" class="control fork" aria-label="Fork"><span aria-hidden="true"><img src="/icons/fork.svg" width="13" height="18" alt="Fork from this point" /></span></button>
set operation = 
	<button type="button" class="control" aria-label="Close"><span aria-hidden="true">&times;</span></button>
	<legend>Set Operation</legend>
	<input type="hidden" name="algprefix[algorithm_name]" value="Set Operation">
	<label for="ctlb-flexiconc-algprefix[operation_type]"><span style="color: red" title="This property is required">*</span> The type of set operation to perform: &#x27;union&#x27;, &#x27;intersection&#x27;, &#x27;difference&#x27;, &#x27;disjunctive union&#x27;, or &#x27;complement&#x27;.</label>
	<select name="algprefix[operation_type]" id="ctlb-flexiconc-algprefix[operation_type]" class="chosen-select " ><option value="union" >union</option> <option value="intersection" >intersection</option> <option value="difference" >difference</option> <option value="disjunctive union" >disjunctive union</option> <option value="complement" >complement</option></select>
	<label for="ctlb-flexiconc-algprefix[nodes]"><span style="color: red" title="This property is required">*</span> A list of nodes to retrieve selected lines from.</label>
	<select name="algprefix[nodes]" id="ctlb-flexiconc-algprefix[nodes]" class="chosen-select allow-add-items" multiple="multiple"></select>
	<pre style="border: 1px solid red">Object type is too loose: {'description': 'The active node, which must be included in the list of nodes.'}</pre>
	<button type="button" class="control fork" aria-label="Fork"><span aria-hidden="true"><img src="/icons/fork.svg" width="13" height="18" alt="Fork from this point" /></span></button>
partition by metadata attribute = 
	<button type="button" class="control" aria-label="Close"><span aria-hidden="true">&times;</span></button>
	<legend>Partition by Metadata Attribute</legend>
	<input type="hidden" name="algprefix[algorithm_name]" value="Partition by Metadata Attribute">
	<label for="ctlb-flexiconc-algprefix[metadata_attribute]"><span style="color: red" title="This property is required">*</span> The metadata attribute to partition by (e.g., &#x27;pos&#x27;, &#x27;speaker&#x27;).</label>
	<input type="text" name="algprefix[metadata_attribute]" id="ctlb-flexiconc-algprefix[metadata_attribute]" class="form-control" >
	<div class="checkbox"><label>
	    <input type="checkbox" name="algprefix[sort_by_partition_size]"   checked>
	    <span>If True, partitions will be sorted by size in descending order.</span>
	 </label></div>
	<label for="ctlb-flexiconc-algprefix[sorted_values]">If provided, partitions will be sorted by these specific values.</label>
	<select name="algprefix[sorted_values]" id="ctlb-flexiconc-algprefix[sorted_values]" class="chosen-select allow-add-items" multiple="multiple"></select>
	<button type="button" class="control fork" aria-label="Fork"><span aria-hidden="true"><img src="/icons/fork.svg" width="13" height="18" alt="Fork from this point" /></span></button>
partition by vectors = 
	<button type="button" class="control" aria-label="Close"><span aria-hidden="true">&times;</span></button>
	<legend>Partition by Vectors</legend>
	<input type="hidden" name="algprefix[algorithm_name]" value="Partition by Vectors">
	<label for="ctlb-flexiconc-algprefix[vectors_column]"><span style="color: red" title="This property is required">*</span> The metadata column containing embeddings for each line.</label>
	<input type="text" name="algprefix[vectors_column]" id="ctlb-flexiconc-algprefix[vectors_column]" class="form-control" >
	<label for="ctlb-flexiconc-algprefix[n_partitions]">The number of partitions/clusters to create.</label>
	<input type="number" name="algprefix[n_partitions]" id="ctlb-flexiconc-algprefix[n_partitions]" class="form-control" value="5" step="1">
	<label for="ctlb-flexiconc-algprefix[metric]">The metric to compute distances between embeddings (used for Agglomerative Clustering only).</label>
	<input type="text" name="algprefix[metric]" id="ctlb-flexiconc-algprefix[metric]" class="form-control" value="cosine">
	<label for="ctlb-flexiconc-algprefix[linkage]">The linkage criterion for Agglomerative Clustering (used only when method is &#x27;agglomerative&#x27;).</label>
	<input type="text" name="algprefix[linkage]" id="ctlb-flexiconc-algprefix[linkage]" class="form-control" value="average">
	<label for="ctlb-flexiconc-algprefix[method]">The clustering method to use (&#x27;agglomerative&#x27; or &#x27;kmeans&#x27;). Default is &#x27;agglomerative&#x27;.</label>
	<select name="algprefix[method]" id="ctlb-flexiconc-algprefix[method]" class="chosen-select " ><option value="agglomerative"  selected>agglomerative</option> <option value="kmeans" >kmeans</option></select>
	<button type="button" class="control fork" aria-label="Fork"><span aria-hidden="true"><img src="/icons/fork.svg" width="13" height="18" alt="Fork from this point" /></span></button>
kwic patterns = 
	<button type="button" class="control" aria-label="Close"><span aria-hidden="true">&times;</span></button>
	<legend>KWIC Patterns</legend>
	<input type="hidden" name="algprefix[algorithm_name]" value="KWIC Patterns">
	<label for="ctlb-flexiconc-algprefix[positions]"><span style="color: red" title="This property is required">*</span> The list of positions (offsets) to extract for the ngram pattern.</label>
	<select name="algprefix[positions]" id="ctlb-flexiconc-algprefix[positions]" class="chosen-select allow-add-items" multiple="multiple"></select>
	<label for="ctlb-flexiconc-algprefix[tokens_attribute]">The positional attribute to search within (e.g., &#x27;word&#x27;).</label>
	<input type="text" name="algprefix[tokens_attribute]" id="ctlb-flexiconc-algprefix[tokens_attribute]" class="form-control" value="word">
	<div class="checkbox"><label>
	    <input type="checkbox" name="algprefix[case_sensitive]"  >
	    <span>If True, the search is case-sensitive.</span>
	 </label></div>
	<button type="button" class="control fork" aria-label="Fork"><span aria-hidden="true"><img src="/icons/fork.svg" width="13" height="18" alt="Fork from this point" /></span></button>
partition with openai = 
	<button type="button" class="control" aria-label="Close"><span aria-hidden="true">&times;</span></button>
	<legend>Partition with OpenAI</legend>
	<input type="hidden" name="algprefix[algorithm_name]" value="Partition with OpenAI">
	<label for="ctlb-flexiconc-algprefix[openai_api_key]"><span style="color: red" title="This property is required">*</span> The API key for OpenAI.</label>
	<input type="text" name="algprefix[openai_api_key]" id="ctlb-flexiconc-algprefix[openai_api_key]" class="form-control" >
	<label for="ctlb-flexiconc-algprefix[n_partitions]">The number of partitions/clusters to create.</label>
	<input type="number" name="algprefix[n_partitions]" id="ctlb-flexiconc-algprefix[n_partitions]" class="form-control" value="5" step="1">
	<label for="ctlb-flexiconc-algprefix[token_attr]">The token attribute to use for creating line texts.</label>
	<input type="text" name="algprefix[token_attr]" id="ctlb-flexiconc-algprefix[token_attr]" class="form-control" value="word">
	<label for="ctlb-flexiconc-algprefix[model]">The OpenAI model to use.</label>
	<input type="text" name="algprefix[model]" id="ctlb-flexiconc-algprefix[model]" class="form-control" value="gpt-4o-2024-11-20">
	<label for="ctlb-flexiconc-algprefix[introduction_line]">Customizable prompt for the clustering task.</label>
	<input type="text" name="algprefix[introduction_line]" id="ctlb-flexiconc-algprefix[introduction_line]" class="form-control" value="You are given a list of lines of text. Cluster them into {n_partitions} clusters by the pattern in which the node word occurs. Ensure that none of the {n_partitions} clusters is empty.">
	<button type="button" class="control fork" aria-label="Fork"><span aria-hidden="true"><img src="/icons/fork.svg" width="13" height="18" alt="Fork from this point" /></span></button>
kwic grouper ranker = 
	<button type="button" class="control" aria-label="Close"><span aria-hidden="true">&times;</span></button>
	<legend>KWIC Grouper Ranker</legend>
	<input type="hidden" name="algprefix[algorithm_name]" value="KWIC Grouper Ranker">
	<label for="ctlb-flexiconc-algprefix[search_term]"><span style="color: red" title="This property is required">*</span> The term to search for within the tokens.</label>
	<input type="text" name="algprefix[search_term]" id="ctlb-flexiconc-algprefix[search_term]" class="form-control" >
	<label for="ctlb-flexiconc-algprefix[tokens_attribute]">The positional attribute to search within (e.g., &#x27;word&#x27;).</label>
	<input type="text" name="algprefix[tokens_attribute]" id="ctlb-flexiconc-algprefix[tokens_attribute]" class="form-control" value="word">
	<div class="checkbox"><label>
	    <input type="checkbox" name="algprefix[regex]"  >
	    <span>If True, use regex for matching the search term.</span>
	 </label></div>
	<div class="checkbox"><label>
	    <input type="checkbox" name="algprefix[case_sensitive]"  >
	    <span>If True, the search is case-sensitive.</span>
	 </label></div>
	<div class="checkbox"><label>
	    <input type="checkbox" name="algprefix[include_node]"  >
	    <span>If True, include node-level tokens in the search.</span>
	 </label></div>
	<label for="ctlb-flexiconc-algprefix[window_start]">The lower bound of the window (offset range).</label>
	<input type="number" name="algprefix[window_start]" id="ctlb-flexiconc-algprefix[window_start]" class="form-control" step="1">
	<label for="ctlb-flexiconc-algprefix[window_end]">The upper bound of the window (offset range).</label>
	<input type="number" name="algprefix[window_end]" id="ctlb-flexiconc-algprefix[window_end]" class="form-control" step="1">
	<div class="checkbox"><label>
	    <input type="checkbox" name="algprefix[count_types]"   checked>
	    <span>If True, count unique types within each line; otherwise, count all matches.</span>
	 </label></div>
	<button type="button" class="control fork" aria-label="Fork"><span aria-hidden="true"><img src="/icons/fork.svg" width="13" height="18" alt="Fork from this point" /></span></button>
select by a token-level attribute = 
	<button type="button" class="control" aria-label="Close"><span aria-hidden="true">&times;</span></button>
	<legend>Select by a Token-Level Attribute</legend>
	<input type="hidden" name="algprefix[algorithm_name]" value="Select by a Token-Level Attribute">
	<label for="ctlb-flexiconc-algprefix[value]"><span style="color: red" title="This property is required">*</span> The value to match against.</label>
	<input type="text" name="algprefix[value]" id="ctlb-flexiconc-algprefix[value]" class="form-control" >
	<label for="ctlb-flexiconc-algprefix[tokens_attribute]">The positional attribute to check (e.g., &#x27;word&#x27;).</label>
	<input type="text" name="algprefix[tokens_attribute]" id="ctlb-flexiconc-algprefix[tokens_attribute]" class="form-control" value="word">
	<label for="ctlb-flexiconc-algprefix[offset]">The offset from the current token to apply the check.</label>
	<input type="number" name="algprefix[offset]" id="ctlb-flexiconc-algprefix[offset]" class="form-control" step="1">
	<div class="checkbox"><label>
	    <input type="checkbox" name="algprefix[case_sensitive]"  >
	    <span>If True, performs a case-sensitive match.</span>
	 </label></div>
	<div class="checkbox"><label>
	    <input type="checkbox" name="algprefix[regex]"  >
	    <span>If True, use regex matching instead of exact matching.</span>
	 </label></div>
	<div class="checkbox"><label>
	    <input type="checkbox" name="algprefix[negative]"  >
	    <span>If True, invert the selection (i.e., select lines where the match fails).</span>
	 </label></div>
	<button type="button" class="control fork" aria-label="Fork"><span aria-hidden="true"><img src="/icons/fork.svg" width="13" height="18" alt="Fork from this point" /></span></button>
manual line selection = 
	<button type="button" class="control" aria-label="Close"><span aria-hidden="true">&times;</span></button>
	<legend>Manual Line Selection</legend>
	<input type="hidden" name="algprefix[algorithm_name]" value="Manual Line Selection">
	<label for="ctlb-flexiconc-algprefix[line_ids]">A list of specific line IDs to include in the subset.</label>
	<select name="algprefix[line_ids]" id="ctlb-flexiconc-algprefix[line_ids]" class="chosen-select allow-add-items" multiple="multiple"></select>
	<label for="ctlb-flexiconc-algprefix[groups]">A list of group identifiers (by label or number) to include lines from. For clusters, groups may be nested, and all matching groups in the hierarchy will be used.</label>
	<select name="algprefix[groups]" id="ctlb-flexiconc-algprefix[groups]" class="chosen-select allow-add-items" multiple="multiple"></select>
	<pre style="border: 1px solid red">Object type is too loose: {'description': 'The active node containing the grouping_result.', 'default': None}</pre>
	<button type="button" class="control fork" aria-label="Fork"><span aria-hidden="true"><img src="/icons/fork.svg" width="13" height="18" alt="Fork from this point" /></span></button>
random sample = 
	<button type="button" class="control" aria-label="Close"><span aria-hidden="true">&times;</span></button>
	<legend>Random Sample</legend>
	<input type="hidden" name="algprefix[algorithm_name]" value="Random Sample">
	<label for="ctlb-flexiconc-algprefix[sample_size]"><span style="color: red" title="This property is required">*</span> The number of lines to sample.</label>
	<input type="number" name="algprefix[sample_size]" id="ctlb-flexiconc-algprefix[sample_size]" class="form-control" step="1">
	<label for="ctlb-flexiconc-algprefix[seed]">An optional seed for random number generation.</label>
	<input type="number" name="algprefix[seed]" id="ctlb-flexiconc-algprefix[seed]" class="form-control" step="1">
