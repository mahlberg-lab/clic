select weighted sample by metadata = 
	<button type="button" class="control" aria-label="Close"><span aria-hidden="true">&times;</span></button>
	<legend>Select Weighted Sample by Metadata</legend>
	<input type="hidden" name="algprefix[algorithm_name]" value="Select Weighted Sample by Metadata">
	<label for="ctlb-flexiconc-algprefix[metadata_attribute]"><span style="color: red" title="This property is required">*</span> The metadata attribute to stratify by (e.g., &#x27;genre&#x27;, &#x27;speaker&#x27;).</label>
	<input type="text" name="algprefix[metadata_attribute]" id="ctlb-flexiconc-algprefix[metadata_attribute]" class="form-control" >
	<label for="ctlb-flexiconc-algprefix[sample_size]"><span style="color: red" title="This property is required">*</span> The total number of lines to sample.</label>
	<input type="number" name="algprefix[sample_size]" id="ctlb-flexiconc-algprefix[sample_size]" class="form-control" step="1">
